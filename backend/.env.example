# =============================================================================
# ParallaxLane — Environment Configuration
# Copy to .env and fill in values. Never commit .env to git.
# =============================================================================

# -----------------------------------------------------------------------------
# LOCAL DEVELOPMENT
# -----------------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string-for-local-dev-only
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=parallaxlane
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=

ORGANISATION_CREATION_ENABLED=True

USE_REDIS_CACHE=False
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_REQUIRED=False

EMAIL_PROVIDER=console
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=no-reply@parallaxlane.com
EMAIL_FROM_NAME=ParallaxLane
EMAIL_PROVIDER_TIMEOUT=10

OTP_MAX_VERIFY_ATTEMPTS=5
OTP_LOCKOUT_SECONDS=900
OTP_VERIFY_WINDOW_SECONDS=300

# -----------------------------------------------------------------------------
# STAGING (copy block below into staging .env)
# -----------------------------------------------------------------------------
# SECRET_KEY=<50+ char random string — generate: python -c "import secrets; print(secrets.token_urlsafe(64))">
# DEBUG=False
# ALLOWED_HOSTS=staging-api.yourdomain.com
#
# DB_HOST=<staging-postgres-host>
# DB_PASSWORD=<staging-db-password>
#
# CORS_ALLOW_ALL_ORIGINS=False
# CORS_ALLOWED_ORIGINS=https://staging.yourdomain.com
#
# USE_REDIS_CACHE=True
# REDIS_URL=redis://:<password>@<staging-redis-host>:6379/0
# REDIS_REQUIRED=True
#
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=<Brevo API key>
# DEFAULT_FROM_EMAIL=no-reply@yourdomain.com
# EMAIL_FROM_NAME=ParallaxLane
# EMAIL_PROVIDER_TIMEOUT=10
#
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# -----------------------------------------------------------------------------
# PRODUCTION (copy block below into production .env)
# -----------------------------------------------------------------------------
# SECRET_KEY=<unique 64+ char secret — rotate invalidates all JWTs>
# DEBUG=False
# ALLOWED_HOSTS=api.yourdomain.com
#
# DB_HOST=<production-postgres-host>
# DB_PASSWORD=<production-db-password>
#
# CORS_ALLOW_ALL_ORIGINS=False
# CORS_ALLOWED_ORIGINS=https://app.yourdomain.com
#
# USE_REDIS_CACHE=True
# REDIS_URL=rediss://:<password>@<upstash-or-redis-host>:6379
# REDIS_REQUIRED=True
#
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=<Brevo API key>
# DEFAULT_FROM_EMAIL=no-reply@yourdomain.com
# EMAIL_FROM_NAME=ParallaxLane
# EMAIL_PROVIDER_TIMEOUT=10
#
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
